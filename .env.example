# ============================================================
# Faza backend â€” environment variables
# Duplicate this file as `.env` and fill in your real values.
# Never commit the real `.env` file.
# ============================================================

# Node environment: development | test | production
NODE_ENV=development

# Host/port the API listens on
HOST=0.0.0.0
PORT=4000
# Maximum image upload size. Keep bounded for memory/DoS protection.
IMAGE_UPLOAD_MAX_MB=25
# Maximum short-video upload size and duration. Keep both bounded.
VIDEO_UPLOAD_MAX_MB=15
VIDEO_MAX_DURATION_SECONDS=5

# MongoDB connection string.
# Local (no auth):
#   mongodb://127.0.0.1:27017/faza
# MongoDB Atlas / remote (always include credentials + authSource):
#   mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/faza?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/faza

# The Next.js frontend origin the API is allowed to serve.
# This is the primary CORS origin. Keep it exact (scheme + host + port).
FRONTEND_URL=http://localhost:3000

# Optional: additional allowed origins, comma-separated.
# Example: https://faza-iota.vercel.app,http://localhost:3001
# Use "*" to allow any origin â€” development only; rejected in production.
CORS_ORIGINS=

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ---- Backoffice (MVP) ----
# Static 4-digit PIN for the Faza application admin (faza/admin screen).
# Yes, hardcoding a PIN is a deliberate MVP shortcut â€” this is a gate, not an
# auth system. Replace it with real authentication before going to production.
APP_ADMIN_PIN=3219

# Secret used to sign the short-lived admin bearer tokens (HS256).
# MUST be a long random value in production; the default dev value is refused
# when NODE_ENV=production. Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# Admin bearer token lifetime, in jsonwebtoken notation (e.g. "12h", "1d").
ADMIN_TOKEN_TTL=12h

# ---- Cloudflare R2 (image uploads) ----
# MongoDB stores only the public delivery URL and R2 object key.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
# Public R2 custom domain or public bucket URL, without a trailing slash.
CLOUDFLARE_R2_PUBLIC_URL=